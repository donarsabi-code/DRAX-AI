# ─────────────────────────────────────────────────────────────────────────────
# DRAX AI — Variables d'environnement
# Copiez ce fichier en « .env » (en local) ou renseignez ces valeurs dans
# Vercel → Projet → Settings → Environment Variables (en ligne).
# ─────────────────────────────────────────────────────────────────────────────

# ─── 1. Base de données (OBLIGATOIRE) ────────────────────────────────────────
# En local (SQLite) :        DATABASE_URL="file:./db/custom.db"
# Sur Vercel (Neon/Postgres) — copiez la chaîne de connexion fournie par Neon :
#   postgresql://utilisateur:motdepasse@hôte/neondb?sslmode=require
DATABASE_URL="postgresql://utilisateur:motdepasse@hôte/neondb?sslmode=require"

# Secret aléatoire stable pour le hachage des codes OTP (OBLIGATOIRE en production).
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET="remplacer-par-une-cle-aleatoire-de-64-caracteres-hexadecimaux"

# ─── 2. Moteur IA intégré (chat, images, transcription vocale) ───────────────
# Utilisé par le SDK z-ai-web-dev-sdk. Sur Vercel, ces 2 variables sont
# transformées en fichier de configuration au moment du build.
ZAI_API_KEY="votre-clé-moteur-ia"
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"

# ─── 3. Moteur de chat alternatif (optionnel — OpenAI-compatible) ────────────
# Si vous préférez un autre fournisseur pour le CHAT uniquement :
#   AI_PROVIDER="openai-compatible"
#   OPENAI_API_KEY="sk-…"
#   OPENAI_BASE_URL="https://api.openai.com/v1"   (ou Groq, OpenRouter…)
#   OPENAI_MODEL="gpt-4o-mini"
# Note : la génération d'images et la voix restent portées par le moteur n°2.

# ─── 4. URL publique de l'application ────────────────────────────────────────
# Sur Vercel : https://votre-projet.vercel.app (déduite automatiquement si vide)
APP_URL=""

# ─── 5. Connexion Google (optionnel — « Se connecter avec Google ») ──────────
# Créés sur console.cloud.google.com → Identifiants → ID client OAuth (Web).
# Origins à déclarer chez Google : https://votre-projet.vercel.app
# URI de redirection : https://votre-projet.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── 6. Connexion Apple (optionnel) ──────────────────────────────────────────
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# ─── 7. E-mail réel — codes de connexion par Gmail (optionnel) ───────────────
# Sans SMTP, l'application reste en mode démo (code affiché à l'écran).
# Avec Gmail : activez la validation en 2 étapes puis créez un mot de passe
# d'application sur https://myaccount.google.com/apppasswords (16 caractères).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="votre.adresse@gmail.com"
SMTP_PASS="mot-de-passe-application-16-caractères"
SMTP_FROM="DRAX AI <votre.adresse@gmail.com>"

# ─── 8. Stockage des images ──────────────────────────────────────────────────
# Automatique : « bdd » sur Vercel (détection VERCEL=1), disque sinon.
# Ne pas modifier sauf besoin particulier.
STORAGE_DRIVER=""
